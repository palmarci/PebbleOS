excludes = []
if not bld.env.CONFIG_GH3X2X_TUNING_SERVICE_ENABLED:
    excludes.extend(['gh3x2x_tuning_service.c'])
if not bld.env.CONFIG_MINIMED_SAKE_SPIKE:
    excludes.extend(['minimed_sake_service.c', 'minimed_sake_crypto.c', 'minimed_sake_aes.c',
                     'minimed_sake_read.c', 'minimed_sake_sender.c', 'minimed_iob.c'])

driver_source = bld.path.ant_glob(['*.c'], excl=excludes)

bld.objects(
    source=driver_source,
    target='bt_driver',
    use=[
      'nimble',
      'freertos',
      'fw_includes',
      'pbl_includes',
    ],
)

